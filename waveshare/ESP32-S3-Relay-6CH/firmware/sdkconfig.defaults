# Rust needs more main-task stack than C
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# 16 MB flash (N16 module confirmed by espflash board-info). Partition table is
# written by espflash from partitions.csv (see espflash.toml), not by the IDF build.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console over the native USB-Serial-JTAG (board has no UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Task watchdog
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Sockets: HTTP server (portal) + captive DNS + mDNS + SNTP + API listener + up to 3 API clients
# + OTA download exceed the default of 10.
CONFIG_LWIP_MAX_SOCKETS=16

# Core dump to flash so a crash leaves a summary the firmware can report in Home Assistant.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_LOGS=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
