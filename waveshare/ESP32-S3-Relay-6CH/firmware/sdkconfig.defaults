# Rust needs more main-task stack than C
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# 16 MB flash (N16 module confirmed by espflash board-info). Partition table is
# written by espflash from partitions.csv (see espflash.toml), not by the IDF build.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console over the native USB-Serial-JTAG (board has no UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Task watchdog
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
